{
  "configurations": [
    {
      "name": "linux-gcc-x64",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "defines": [
        "USE_HAL_DRIVER",
        "STM32H755xx",
        "CORE_CM7",
        "BOOTLOADER"
      ],
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "${default}",
      "cppStandard": "${default}",
      "intelliSenseMode": "linux-gcc-x64",
      "compilerArgs": [
        "-mcpu=cortex-m7",
        "-mthumb",
        "-ffunction-sections",
        "-fdata-sections"
      ]
    },
    {
      "name": "Bootloader (STM32H755xx)",
      "includePath": [
        "${workspaceFolder}/Bootloader/Core/Inc",
